# Nyaya Legal AI - Environment Variables Template
# Copy this file to .env or configure these variables in your deployment environment.

# Groq API Keys for AI Assistant & Legal Learning modules
GROQ_API_KEY=your_groq_api_key_here
GROQ_LEARNING_API_KEY=your_groq_learning_api_key_here
GROQ_ASSISTANT_API_KEY=your_groq_assistant_api_key_here

# Gemini API Keys (if applicable)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ASSISTANT_API_KEY=your_gemini_assistant_api_key_here
